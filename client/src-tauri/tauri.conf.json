{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenAgentFleet",
  "version": "0.1.0",
  "identifier": "com.openagentfleet.desktop",
  "build": {
    "beforeDevCommand": "pnpm run prepare:sidecar && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run prepare:sidecar && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenAgentFleet",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:4317; img-src 'self' asset: data: blob:; media-src 'self' blob:; style-src 'self'; script-src 'self'; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/botd", "binaries/browser-mcp", "binaries/uv", "binaries/uvx", "binaries/opencode"],
    "resources": {
      "../../runtime/agent-computer/": "agent-computer/"
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
